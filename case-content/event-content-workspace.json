    {
      "name": "Header",
      "blocks": [
        {
          "type": "h1",
          "text": "Event Content Workspace"
        },
        {
          "type": "p",
          "text": "Connecting participant submissions, content production, and publishing in one streamlined event workflow."
        },
        {
          "type": "p",
          "text": "A B2B content operations workspace for event teams to collect participant information, coordinate promotional content, and keep campaigns on schedule. Designed end-to-end from product strategy and UX/UI to an AI-assisted functional prototype."
        },
        {
          "type": "p",
          "text": "MY ROLE"
        },
        {
          "type": "p",
          "text": "Product Designer"
        },
        {
          "type": "p",
          "text": "TOOLS"
        },
        {
          "type": "p",
          "text": "Figma, Claude, Codex"
        },
        {
          "type": "p",
          "text": "Timeline"
        },
        {
          "type": "p",
          "text": "1 week, Oct 2026"
        }
      ]
    },
    {
      "name": "Gallery",
      "blocks": [
        {
          "type": "image",
          "src": "https://framerusercontent.com/images/Q9DW8pp9B1K6chtvlrafKNeBAk.png",
          "width": "3024",
